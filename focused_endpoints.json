{
  "info": {
    "name": "MedBond API - Key Endpoints",
    "description": "Focused collection for key MedBond API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Dependents",
      "item": [
        {
          "name": "Get All Dependents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dependents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dependents"]
            }
          }
        },
        {
          "name": "Get Dependents by Employee ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dependents/employee/:employeeId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dependents", "employee", ":employeeId"],
              "variable": [
                {
                  "key": "employeeId",
                  "value": "123456"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Historical Claims",
      "item": [
        {
