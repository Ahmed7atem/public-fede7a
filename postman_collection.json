{
  "info": {
    "name": "Pre-approval APIs",
    "description": "Collection of APIs for managing pre-approval requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Pre-approvals",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/pre-approvals",
          "host": ["{{base_url}}"],
          "path": ["api", "pre-approvals"]
        }
      }
    },
    {
      "name": "Get Pre-approval by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/pre-approvals/:id",
          "host": ["{{base_url}}"],
          "path": ["api", "pre-approvals", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "pre-approval-id-here",
              "description": "ID of the pre-approval request"
            }
          ]
        }
      }
    },
    {
      "name": "Get Pre-approvals by Employee ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/pre-approvals/employee/:employeeId",
          "host": ["{{base_url}}"],
          "path": ["api", "pre-approvals", "employee", ":employeeId"],
          "variable": [
            {
              "key": "employeeId",
              "value": "EMP123",
              "description": "Employee ID"
            }
          ]
        }
      }
    },
    {
      "name": "Create Pre-approval",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "employeeId",
              "value": "EMP123",
              "type": "text"
            },
            {
              "key": "providerType",
              "value": "Hospital",
              "type": "text"
            },
            {
              "key": "providerName",
              "value": "City General Hospital",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Scheduled for knee replacement surgery",
              "type": "text"
            },
            {
              "key": "attachments",
              "type": "file",
              "src": "/path/to/your/file.jpg"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/pre-approvals",
          "host": ["{{base_url}}"],
          "path": ["api", "pre-approvals"]
        }
      }
    },
    {
      "name": "Update Pre-approval Status",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"status\": \"Approved\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/pre-approvals/:id",
          "host": ["{{base_url}}"],
          "path": ["api", "pre-approvals", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "pre-approval-id-here",
              "description": "ID of the pre-approval request"
            }
          ]
        }
      }
    },
    {
      "name": "Delete Pre-approval",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/pre-approvals/:id",
          "host": ["{{base_url}}"],
          "path": ["api", "pre-approvals", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "pre-approval-id-here",
              "description": "ID of the pre-approval request"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your-jwt-token-here",
      "type": "string"
    }
  ]
} 