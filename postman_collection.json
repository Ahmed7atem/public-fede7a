{
  "info": {
    "name": "Health Provider API Collection",
    "description": "Collection of all GET and POST APIs for the Health Provider application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"name\": \"John Doe\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Health Providers",
      "item": [
        {
          "name": "Get All Providers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/health-providers",
              "host": ["{{base_url}}"],
              "path": ["api", "health-providers"]
            }
          }
        },
        {
          "name": "Get Provider by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/health-providers/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "health-providers", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "provider_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Create Provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/health-providers",
              "host": ["{{base_url}}"],
              "path": ["api", "health-providers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Provider Name\",\n    \"address\": \"Provider Address\",\n    \"phone\": \"1234567890\",\n    \"email\": \"provider@example.com\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Pre-approvals",
      "item": [
        {
          "name": "Get All Pre-approvals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pre-approvals",
              "host": ["{{base_url}}"],
              "path": ["api", "pre-approvals"]
            }
          }
        },
        {
          "name": "Get Pre-approval by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pre-approvals/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "pre-approvals", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "pre_approval_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Create Pre-approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pre-approvals",
              "host": ["{{base_url}}"],
              "path": ["api", "pre-approvals"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"providerId\": \"provider_id_here\",\n    \"serviceType\": \"service_type\",\n    \"description\": \"Service description\",\n    \"estimatedCost\": 1000,\n    \"requestedDate\": \"2024-03-20\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "upload"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/file"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your_jwt_token_here",
      "type": "string"
    }
  ]
} 