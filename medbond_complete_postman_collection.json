    {
      "name": "Environment Setup",
      "item": [
        {
          "name": "Set Base URL",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('base_url', 'http://localhost:3000');"
                ]
              }
            }
          ]
        }
      ]
    },
