            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"employee\",\n  \"age\": 30,\n  \"gender\": \"male\",\n  \"children\": 0,\n  \"smoker\": false\n}"
            },
