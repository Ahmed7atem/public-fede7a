{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Upload API",
		"description": "Collection for testing the upload API endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Upload File",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": "/path/to/your/file.png"
						},
						{
							"key": "type",
							"value": "special-claim",
							"type": "text",
							"description": "Type of upload (special-claim, pre-approval, or complaint)"
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/upload",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"upload"
					]
				},
				"description": "Upload a file with type specification"
			},
			"response": []
		},
		{
			"name": "Get Files by Type",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/upload/type/special-claim",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"upload",
						"type",
						"special-claim"
					]
				},
				"description": "Get all files of a specific type"
			},
			"response": []
		},
		{
			"name": "Get File by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/upload/{{fileId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"upload",
						"{{fileId}}"
					]
				},
				"description": "Get a specific file by ID"
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://public-fede7a.vercel.app",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_AUTH_TOKEN",
			"type": "string"
		},
		{
			"key": "fileId",
			"value": "FILE_ID_HERE",
			"type": "string"
		}
	]
} 