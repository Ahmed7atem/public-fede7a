{
  "info": {
    "name": "Complaints API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Complaint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "providerType",
              "value": "Hospital",
              "type": "text",
              "description": "Required"
            },
            {
              "key": "employeeId",
              "value": "8f7b7927-6c04-401a-ab0b-61000132f970",
              "type": "text",
              "description": "Required"
            },
            {
              "key": "description",
              "value": "Test complaint",
              "type": "text",
              "description": "Optional"
            },
            {
              "key": "attachment",
              "type": "file",
              "src": "",
              "description": "Optional - PDF or image"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/complaints",
          "host": ["{{baseUrl}}"],
          "path": ["api", "complaints"]
        }
      }
    }
  ]
}