      {
        "name": "File Attachments",
        "item": [
          {
            "name": "Upload Files",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "body": {
                "mode": "formdata",
                "formdata": [
                  {
                    "key": "files",
                    "type": "file",
                    "src": []
                  },
                  {
                    "key": "type",
                    "value": "claim",
                    "type": "text"
                  },
                  {
                    "key": "referenceId",
                    "value": "{{claim_id}}",
                    "type": "text"
                  },
                  {
                    "key": "description",
                    "value": "Medical bills and receipts",
                    "type": "text"
                  }
                ]
              },
              "url": {
                "raw": "{{base_url}}/api/attachments/upload",
                "host": ["{{base_url}}"],
                "path": ["api", "attachments", "upload"]
              }
            }
          },
          {
            "name": "Download File",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/attachments/download/:id",
                "host": ["{{base_url}}"],
                "path": ["api", "attachments", "download", ":id"]
              }
            }
          },
          {
            "name": "Get File Metadata",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/attachments/metadata/:id",
                "host": ["{{base_url}}"],
                "path": ["api", "attachments", "metadata", ":id"]
              }
            }
          },
          {
            "name": "Delete File",
            "request": {
              "method": "DELETE",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/attachments/:id",
                "host": ["{{base_url}}"],
                "path": ["api", "attachments", ":id"]
              }
            }
          },
          {
            "name": "Get All Attachments",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/attachments/:type/:referenceId",
                "host": ["{{base_url}}"],
                "path": ["api", "attachments", ":type", ":referenceId"]
              }
            }
          }
        ]
      },
