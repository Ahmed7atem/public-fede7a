                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/claims/{{claim_id}}",
                "host": ["{{base_url}}"],
                "path": ["api", "claims", "{{claim_id}}"]
              }
            }
          },
          {
            "name": "Update Claim Status",
            "request": {
              "method": "PUT",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
