      {
        "name": "Claims",
        "item": [
          {
            "name": "Submit Claim with Attachments",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "body": {
                "mode": "formdata",
                "formdata": [
                  {
                    "key": "type",
                    "value": "medical",
                    "type": "text"
                  },
                  {
                    "key": "amount",
                    "value": "500",
                    "type": "text"
                  },
                  {
                    "key": "description",
                    "value": "Doctor visit",
                    "type": "text"
                  },
                  {
                    "key": "date",
                    "value": "2024-04-24",
                    "type": "text"
                  },
                  {
                    "key": "provider",
                    "value": "City Hospital",
                    "type": "text"
                  },
                  {
                    "key": "files",
                    "type": "file",
                    "src": []
                  },
                  {
                    "key": "attachmentDescription",
                    "value": "Medical bills and receipts",
                    "type": "text"
                  }
                ]
              },
              "url": {
                "raw": "{{base_url}}/api/claims",
                "host": ["{{base_url}}"],
                "path": ["api", "claims"]
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "var jsonData = pm.response.json();",
                    "pm.environment.set('claim_id', jsonData._id);"
                  ]
                }
              }
            ]
          },
          {
            "name": "Get All Claims",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/claims",
                "host": ["{{base_url}}"],
                "path": ["api", "claims"]
