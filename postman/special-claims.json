{
  "info": {
    "name": "Special Claims API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Special Claims",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/claims/special",
          "host": ["{{baseUrl}}"],
          "path": ["api", "claims", "special"]
        }
      }
    },
    {
      "name": "Get Special Claims by Employee ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/claims/special/employee/:employeeId",
          "host": ["{{baseUrl}}"],
          "path": ["api", "claims", "special", "employee", ":employeeId"],
          "variable": [
            {
              "key": "employeeId",
              "value": "EMP123",
              "description": "Employee ID"
            }
          ]
        }
      }
    },
    {
      "name": "Create Special Claim",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"policyNumber\": \"POL123456\",\n    \"policyHolderName\": \"John Doe\",\n    \"employeeId\": \"EMP123\",\n    \"email\": \"john.doe@example.com\",\n    \"number\": \"+1234567890\",\n    \"claimFor\": \"Dental\",\n    \"claimForId\": \"DEN001\",\n    \"country\": \"USA\",\n    \"claimAmount\": 1500.00,\n    \"currency\": \"USD\",\n    \"dateOfTreatment\": \"2024-03-20\",\n    \"paymentMethod\": \"Credit Card\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/claims/special",
          "host": ["{{baseUrl}}"],
          "path": ["api", "claims", "special"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your-auth-token-here",
      "type": "string"
    }
  ]
}