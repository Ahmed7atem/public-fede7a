{
  "info": {
    "name": "Special Claims API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Special Claim",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "policyNumber",
              "value": "POL123456",
              "type": "text",
              "description": "Policy number"
            },
            {
              "key": "policyHolderName",
              "value": "John Doe",
              "type": "text",
              "description": "Name of the policy holder"
            },
            {
              "key": "employeeId",
              "value": "EMP789",
              "type": "text",
              "description": "Employee ID"
            },
            {
              "key": "email",
              "value": "john.doe@example.com",
              "type": "text",
              "description": "Email address"
            },
            {
              "key": "number",
              "value": "+1234567890",
              "type": "text",
              "description": "Contact number"
            },
            {
              "key": "claimFor",
              "value": "employee",
              "type": "text",
              "description": "Type of claim"
            },
            {
              "key": "claimForId",
              "value": "CLM456",
              "type": "text",
              "description": "Claim ID"
            },
            {
              "key": "country",
              "value": "USA",
              "type": "text",
              "description": "Country"
            },
            {
              "key": "claimAmount",
              "value": "1500.75",
              "type": "text",
              "description": "Amount of the claim"
            },
            {
              "key": "currency",
              "value": "EGP",
              "type": "text",
              "description": "Currency code"
            },
            {
              "key": "dateOfTreatment",
              "value": "2024-05-14",
              "type": "text",
              "description": "Date of treatment (YYYY-MM-DD)"
            },
            {
              "key": "paymentMethod",
              "value": "Bank Transfer",
              "type": "text",
              "description": "Payment method"
            },
            {
              "key": "bankName",
              "value": "Bank of America",
              "type": "text",
              "description": "Bank name"
            },
            {
              "key": "branchName",
              "value": "Main Branch",
              "type": "text",
              "description": "Branch name"
            },
            {
              "key": "accountNumber",
              "value": "123456789012",
              "type": "text",
              "description": "Account number"
            },
            {
              "key": "swiftCode",
              "value": "BOFAUS3N",
              "type": "text",
              "description": "SWIFT code"
            },
            {
              "key": "iban",
              "value": "US12345678901234567890",
              "type": "text",
              "description": "IBAN"
            },
            {
              "key": "description",
              "value": "Medical treatment for surgery",
              "type": "text",
              "description": "Description of the claim"
            },
            {
              "key": "attachments",
              "type": "file",
              "src": "",
              "description": "Supporting documents (up to 5 files)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/claims/special-claims",
          "host": ["{{baseUrl}}"],
          "path": ["api", "claims", "special-claims"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://public-fede7a.vercel.app",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your_auth_token_here",
      "type": "string"
    }
  ]
}