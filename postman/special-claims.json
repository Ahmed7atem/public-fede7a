{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890",
    "name": "Special Claims API",
    "description": "API collection for managing special claims",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Special Claims",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/claims/special",
          "host": ["{{baseUrl}}"],
          "path": ["api", "claims", "special"]
        },
        "description": "Get all special claims (requires admin access)"
      }
    },
    {
      "name": "Get Special Claims by Employee ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/claims/special/employee/:employeeId",
          "host": ["{{baseUrl}}"],
          "path": ["api", "claims", "special", "employee", ":employeeId"],
          "variable": [
            {
              "key": "employeeId",
              "value": "EMP789",
              "description": "Employee ID"
            }
          ]
        },
        "description": "Get special claims for a specific employee"
      }
    },
    {
