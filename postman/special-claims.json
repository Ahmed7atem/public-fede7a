{
  "info": {
    "name": "Special Claims and Predictions APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Special Claims",
      "item": [
        {
          "name": "Create Special Claim",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/claims/special-claims",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyNumber\": \"POL123456\",\n  \"policyHolderName\": \"John Doe\",\n  \"employeeId\": \"8f7b7927-6c04-401a-ab0b-61000132f970\",\n  \"email\": \"john.doe@example.com\",\n  \"number\": \"+1234567890\",\n  \"claimFor\": \"employee\",\n  \"claimForId\": \"8f7b7927-6c04-401a-ab0b-61000132f970\",\n  \"country\": \"USA\",\n  \"claimAmount\": 1500.75,\n  \"currency\": \"USD\",\n  \"dateOfTreatment\": \"2023-05-01\",\n  \"paymentMethod\": \"Bank Transfer\",\n  \"bankName\": \"Bank of America\",\n  \"branchName\": \"Main Branch\",\n  \"accountNumber\": \"123456789012\",\n  \"swiftCode\": \"BOFAUS3N\",\n  \"iban\": \"US12345678901234567890\",\n  \"description\": \"Medical treatment for surgery\"\n}"
            }
          }
        },
        {
          "name": "Get All Special Claims",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/claims/special",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Special Claims by Employee ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/claims/special/employee/{{employeeId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Predictions",
      "item": [
        {
          "name": "Create Prediction",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/predictions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Patient_ID\": \"041a0974-dd03-462c-83a5-3334c70b95ac\",\n  \"Health_Status\": \"Critical\",\n  \"Insurance_Consumption\": \"High\",\n  \"Needs_Insurance_Update\": \"Yes\",\n  \"Suggested_Plan\": \"Platinum\",\n  \"Recommendations\": [\n    \"Quit smoking or seek cessation support.\",\n    \"Monitor blood sugar and reduce sugar intake.\"\n  ],\n  \"Message\": \"Employee 041a0974-dd03-462c-83a5-3334c70b95ac is categorized as 'Critical'. Insurance package update is recommended. Suggested plan: Platinum. Key advice: Quit smoking or seek cessation support.; Monitor blood sugar and reduce sugar intake.\"\n}"
            }
          }
        },
        {
          "name": "Get All Predictions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/predictions",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get Predictions by Employee ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/predictions/employee/{{predictionEmployeeId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://public-fede7a.vercel.app"
    },
    {
      "key": "token",
      "value": "your_jwt_token_here"
    },
    {
      "key": "employeeId",
      "value": "8f7b7927-6c04-401a-ab0b-61000132f970"
    },
    {
      "key": "predictionEmployeeId",
      "value": "041a0974-dd03-462c-83a5-3334c70b95ac"
    }
  ]
} 