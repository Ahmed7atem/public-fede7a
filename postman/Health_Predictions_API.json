    {
      "name": "Claims",
      "item": [
        {
          "name": "Submit Claim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"provider\": \"507f1f77bcf86cd799439011\",\n    \"claimAmount\": 500,\n    \"patientAge\": 35,\n    \"providerSpecialty\": \"Cardiology\",\n    \"patientIncome\": 75000,\n    \"claimDate\": \"2024-04-24\",\n    \"patientMaritalStatus\": \"Single\",\n    \"patientEmploymentStatus\": \"Employed\",\n    \"claimType\": \"Routine\",\n    \"diagnosisDescription\": \"Annual checkup\",\n    \"procedureDescription\": \"Physical examination\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/claims",
              "host": ["{{base_url}}"],
              "path": ["api", "claims"]
            }
          }
        },
        {
          "name": "Get Claim by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
